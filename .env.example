# Application Configuration
APP_URL=http://localhost:3000

# JWT Configuration
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Turso/libsql Database Configuration
# For cloud deployment, use: lib://your-db-name.turso.io
# For local development, use: file:./local.db
TURSO_DATABASE_URL=your_turso_database_url
TURSO_AUTH_TOKEN=your_turso_auth_token

# Optional: Edge Store for image uploads (if not using local storage)
# EDGE_STORE_ACCESS_KEY=your_access_key
# EDGE_STORE_SECRET_KEY=your_secret_key
